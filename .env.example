# Generate real local values with scripts/Init-Env.ps1 or scripts/init-env.sh.
# Never commit .env. Docker Compose reads it automatically.
POSTGRES_DB=ktor_realtime
POSTGRES_USER=realtime_app
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD_AT_LEAST_10_CHARACTERS
APP_PORT=8091
PG_PORT=55435
